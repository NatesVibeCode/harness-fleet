{
  "$defs": {
    "ExtractedItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "source_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "content_type": {
          "title": "Content Type",
          "type": "string"
        },
        "claims": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Claims",
          "type": "object"
        },
        "quotes": {
          "items": {
            "$ref": "#/$defs/QuoteRef"
          },
          "minItems": 1,
          "title": "Quotes",
          "type": "array"
        },
        "captured_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO-8601 evidence capture time from input metadata; None means ageless",
          "title": "Captured At"
        },
        "scored_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO-8601 scoring time; fixed at verification so revalidation is stable",
          "title": "Scored At"
        }
      },
      "required": [
        "item_id",
        "source_digest",
        "content_type",
        "claims",
        "quotes"
      ],
      "title": "ExtractedItem",
      "type": "object"
    },
    "JsonValue": {},
    "PacketAudit": {
      "additionalProperties": false,
      "properties": {
        "total_batches_processed": {
          "minimum": 0,
          "title": "Total Batches Processed",
          "type": "integer"
        },
        "total_tokens_consumed": {
          "minimum": 0,
          "title": "Total Tokens Consumed",
          "type": "integer"
        },
        "total_cost_reported": {
          "minimum": 0,
          "title": "Total Cost Reported",
          "type": "number"
        },
        "batches_verified": {
          "minimum": 0,
          "title": "Batches Verified",
          "type": "integer"
        },
        "batches_failed": {
          "minimum": 0,
          "title": "Batches Failed",
          "type": "integer"
        },
        "model_attempts": {
          "minimum": 0,
          "title": "Model Attempts",
          "type": "integer"
        },
        "receipts_recorded": {
          "minimum": 0,
          "title": "Receipts Recorded",
          "type": "integer"
        },
        "unknown_cost_attempts": {
          "minimum": 0,
          "title": "Unknown Cost Attempts",
          "type": "integer"
        }
      },
      "required": [
        "total_batches_processed",
        "total_tokens_consumed",
        "total_cost_reported",
        "batches_verified",
        "batches_failed",
        "model_attempts",
        "receipts_recorded",
        "unknown_cost_attempts"
      ],
      "title": "PacketAudit",
      "type": "object"
    },
    "ProviderReceipt": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "requested_route": {
          "title": "Requested Route",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "cost_status": {
          "default": "unknown",
          "enum": [
            "reported_zero",
            "billed",
            "unknown"
          ],
          "title": "Cost Status",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "error_type": {
          "anyOf": [
            {
              "enum": [
                "rate_limit",
                "transient_http",
                "inference_error",
                "auth_error",
                "timeout",
                "unsupported"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "retry_after": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After"
        }
      },
      "required": [
        "id",
        "provider",
        "requested_route",
        "status"
      ],
      "title": "ProviderReceipt",
      "type": "object"
    },
    "QuoteRef": {
      "additionalProperties": false,
      "properties": {
        "slice_id": {
          "description": "Exact source slice containing the quote",
          "minLength": 1,
          "title": "Slice Id",
          "type": "string"
        },
        "start": {
          "description": "Inclusive absolute character offset",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "Exclusive absolute character offset",
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "text": {
          "description": "Exact source substring at start:end",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "supports": {
          "description": "Checklist item ids this quote backs",
          "items": {
            "type": "string"
          },
          "title": "Supports",
          "type": "array"
        }
      },
      "required": [
        "slice_id",
        "start",
        "end",
        "text"
      ],
      "title": "QuoteRef",
      "type": "object"
    },
    "RoutePolicy": {
      "additionalProperties": false,
      "properties": {
        "allowed_transports": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional allowlist of harness-fleet transport names",
          "title": "Allowed Transports"
        },
        "excluded_transports": {
          "description": "Blocklist of harness-fleet transport names",
          "items": {
            "type": "string"
          },
          "title": "Excluded Transports",
          "type": "array"
        },
        "allowed_providers": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Deprecated alias for allowed_transports",
          "title": "Allowed Providers"
        },
        "excluded_providers": {
          "description": "Deprecated alias for excluded_transports",
          "items": {
            "type": "string"
          },
          "title": "Excluded Providers",
          "type": "array"
        },
        "allowed_routes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional allowlist of route IDs",
          "title": "Allowed Routes"
        },
        "excluded_routes": {
          "description": "Blocklist of route IDs",
          "items": {
            "type": "string"
          },
          "title": "Excluded Routes",
          "type": "array"
        },
        "zdr": {
          "default": false,
          "description": "Enforce Zero Data Retention on upstream providers",
          "title": "Zdr",
          "type": "boolean"
        },
        "allow_data_collection": {
          "default": true,
          "description": "Whether providers may collect request data",
          "title": "Allow Data Collection",
          "type": "boolean"
        },
        "max_cost_per_1k_input": {
          "default": 0.0,
          "description": "Max allowed cost per 1k input tokens",
          "minimum": 0,
          "title": "Max Cost Per 1K Input",
          "type": "number"
        },
        "max_cost_per_1k_output": {
          "default": 0.0,
          "description": "Max allowed cost per 1k output tokens",
          "minimum": 0,
          "title": "Max Cost Per 1K Output",
          "type": "number"
        },
        "max_request_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Max allowed spend per single request",
          "title": "Max Request Cost"
        },
        "free_only": {
          "default": false,
          "description": "Explicit flag to restrict to observed-zero routes only",
          "title": "Free Only",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Operator-recorded reason for a routing choice (e.g. trust basis for an approved paid route)",
          "title": "Note"
        },
        "openrouter_providers": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upstream OpenRouter providers to prioritize",
          "title": "Openrouter Providers"
        },
        "openrouter_ignore": {
          "description": "Upstream OpenRouter providers to ignore",
          "items": {
            "type": "string"
          },
          "title": "Openrouter Ignore",
          "type": "array"
        },
        "openrouter_order": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upstream OpenRouter provider ordering",
          "title": "Openrouter Order"
        },
        "openrouter_allow_fallbacks": {
          "default": true,
          "description": "Whether OpenRouter may fall back to other providers",
          "title": "Openrouter Allow Fallbacks",
          "type": "boolean"
        }
      },
      "title": "RoutePolicy",
      "type": "object"
    },
    "TaskSpec": {
      "$id": "https://raw.githubusercontent.com/NatesVibeCode/harness-fleet/master/schemas/task-v1.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "https://raw.githubusercontent.com/NatesVibeCode/harness-fleet/master/schemas/task-v1.schema.json",
          "default": "https://raw.githubusercontent.com/NatesVibeCode/harness-fleet/master/schemas/task-v1.schema.json",
          "title": "$Schema",
          "type": "string"
        },
        "format_version": {
          "const": "harness_fleet_task_v1",
          "default": "harness_fleet_task_v1",
          "title": "Format Version",
          "type": "string"
        },
        "name": {
          "description": "Stable task name",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Name",
          "type": "string"
        },
        "instructions": {
          "default": "Extract only facts supported by the supplied source slices.",
          "description": "Outcome-specific directions; field structure belongs in claims_schema",
          "title": "Instructions",
          "type": "string"
        },
        "batch_size": {
          "default": 6,
          "description": "Maximum input items per model request",
          "maximum": 100,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "max_slice_chars": {
          "default": 6000,
          "description": "Maximum source characters exposed per item",
          "maximum": 100000,
          "minimum": 300,
          "title": "Max Slice Chars",
          "type": "integer"
        },
        "min_quote_chars": {
          "default": 15,
          "description": "Minimum admitted evidence-quote length",
          "maximum": 10000,
          "minimum": 1,
          "title": "Min Quote Chars",
          "type": "integer"
        },
        "claims_schema": {
          "additionalProperties": true,
          "description": "Draft 2020-12 object schema; type=object and additionalProperties=false are required",
          "title": "Claims Schema",
          "type": "object"
        },
        "checklist": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Checklist item id to score points; the pipeline derives score from true answers",
          "title": "Checklist"
        },
        "pass_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum derived score that yields passed=true; the pipeline derives the boolean",
          "title": "Pass Score"
        },
        "evidence_terms": {
          "description": "Terms used to rank deterministic evidence-candidate spans per section",
          "items": {
            "type": "string"
          },
          "title": "Evidence Terms",
          "type": "array"
        },
        "candidate_top_n": {
          "default": 6,
          "description": "Maximum evidence-candidate spans exposed per section",
          "maximum": 32,
          "minimum": 1,
          "title": "Candidate Top N",
          "type": "integer"
        },
        "source_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Lowercased URI substring to evidentiary weight 0-1; longest match wins, 0 blocks support",
          "title": "Source Weights",
          "type": "object"
        },
        "default_source_weight": {
          "default": 1.0,
          "description": "Weight for sources matching no rule; 1 preserves legacy unweighted scoring",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Default Source Weight",
          "type": "number"
        },
        "recency_half_lives": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Checklist item id to evidence half-life in days; support decays by half each period",
          "title": "Recency Half Lives",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "TaskSpec",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/NatesVibeCode/harness-fleet/master/schemas/packet-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/NatesVibeCode/harness-fleet/master/schemas/packet-v2.schema.json",
      "default": "https://raw.githubusercontent.com/NatesVibeCode/harness-fleet/master/schemas/packet-v2.schema.json",
      "title": "$Schema",
      "type": "string"
    },
    "format_version": {
      "const": "harness_fleet_v2",
      "default": "harness_fleet_v2",
      "title": "Format Version",
      "type": "string"
    },
    "exported_at": {
      "title": "Exported At",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/TaskSpec"
    },
    "task_revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Task Revision",
      "type": "string"
    },
    "input_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "total_verified_records": {
      "minimum": 0,
      "title": "Total Verified Records",
      "type": "integer"
    },
    "audit": {
      "$ref": "#/$defs/PacketAudit"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ExtractedItem"
      },
      "title": "Records",
      "type": "array"
    },
    "receipts": {
      "items": {
        "$ref": "#/$defs/ProviderReceipt"
      },
      "title": "Receipts",
      "type": "array"
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoutePolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "exported_at",
    "run_id",
    "task",
    "task_revision",
    "input_digest",
    "total_verified_records",
    "audit",
    "records",
    "receipts"
  ],
  "title": "CleanPacket",
  "type": "object"
}
