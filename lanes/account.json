{
  "name": "account",
  "description": "Target accounts for a technical ICP: who is doing the work, and who is hiring for it",
  "queries": [
    "\"case study\" \"Kafka\" implementation bank -site:medium.com",
    "\"customer story\" (\"Snowflake\" OR \"Databricks\" OR \"Confluent\") implementation partner"
  ],
  "backends": [
    "ddgs",
    "hn"
  ],
  "preset": "account-research",
  "tier": "tier_2",
  "top": 25,
  "revision": 1,
  "funnel": {
    "allows": "services",
    "ladder": [
      {
        "name": "result",
        "evidence": "snippet",
        "gates": [
          "kind",
          "size",
          "location"
        ],
        "earns": "eliminates a product vendor, or earns one page visit — it never qualifies"
      },
      {
        "name": "surface",
        "evidence": "fetched",
        "gates": [
          "kind",
          "size",
          "location"
        ],
        "surfaces": [
          "about",
          "services",
          "careers"
        ],
        "earns": "qualifies the cheap gates; the stack they actually deliver lives here"
      },
      {
        "name": "stories",
        "evidence": "fetched",
        "gates": [
          "vertical"
        ],
        "surfaces": [
          "case_studies",
          "blog",
          "news"
        ],
        "earns": "settles which industries the work is actually in"
      }
    ]
  }
}
