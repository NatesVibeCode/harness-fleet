{
  "name": "partner",
  "description": "Implementation partners and consultancies, from vendor-published stories",
  "queries": [
    "\"{tech}\" \"implementation partner\" (\"case study\" OR \"customer story\")",
    "\"{tech}\" \"systems integrator\" (certified OR \"premier partner\")",
    "\"{tech}\" consultancy \"our client\" (migration OR implementation)",
    "\"{tech}\" \"professional services\" partner -site:medium.com",
    "\"managed service provider\" \"{tech}\" \"{vertical}\"",
    "\"{tech}\" data consultancy (\"case study\" OR \"we built\")"
  ],
  "backends": [
    "ddgs",
    "hn"
  ],
  "preset": "partner-research",
  "tier": "tier_1",
  "top": 25,
  "revision": 5,
  "stories": 80,
  "resolve_stories": 60,
  "story_paths": [
    "/partners/"
  ],
  "story_partner_half": true,
  "query_terms": {
    "tech": [
      "Kafka",
      "Snowflake",
      "Databricks",
      "dbt",
      "Kubernetes"
    ],
    "vertical": [
      "fintech",
      "healthcare",
      "retail",
      "logistics"
    ]
  },
  "max_queries": 34,
  "funnel": {
    "allows": "services",
    "ladder": [
      {
        "name": "result",
        "evidence": "snippet",
        "gates": [
          "kind",
          "size",
          "location"
        ],
        "earns": "eliminates a product vendor, or earns one page visit — it never qualifies"
      },
      {
        "name": "surface",
        "evidence": "fetched",
        "gates": [
          "kind",
          "size",
          "location"
        ],
        "surfaces": [
          "about",
          "services",
          "careers"
        ],
        "earns": "qualifies the cheap gates on their own pages, where a snippet may not"
      },
      {
        "name": "stories",
        "evidence": "fetched",
        "gates": [
          "vertical"
        ],
        "surfaces": [
          "case_studies",
          "partners",
          "blog",
          "news"
        ],
        "earns": "settles the vertical gate, which only the case studies can answer"
      }
    ]
  }
}
