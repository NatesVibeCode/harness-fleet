{
  "name": "account",
  "description": "Target accounts for a technical ICP: a competitor's customers — the firms that buy in this space, and what they run",
  "onboarding_profile": "ideal_company",
  "queries": [
    "\"case study\" \"{tech}\" (implementation OR migration) -site:medium.com",
    "\"customer story\" \"{tech}\" (\"we migrated\" OR \"our data platform\")",
    "\"{tech}\" \"{pain}\" (architecture OR engineering)"
  ],
  "query_terms": {
    "tech": [
      "Kafka",
      "Snowflake",
      "Databricks",
      "Confluent"
    ],
    "pain": [
      "we migrated",
      "our data platform"
    ]
  },
  "backends": [
    "ddgs",
    "hn"
  ],
  "preset": "account-research",
  "tier": "tier_3",
  "top": 25,
  "revision": 8,
  "stories": 0,
  "resolve_stories": 0,
  "funnel": {
    "allows": "any",
    "ladder": [
      {
        "name": "result",
        "evidence": "snippet",
        "gates": [
          "size",
          "location"
        ],
        "resolve": [
          "location",
          "size"
        ],
        "earns": "eliminates on firmographics, or earns one page visit — it never qualifies"
      },
      {
        "name": "surface",
        "evidence": "fetched",
        "gates": [
          "size",
          "location"
        ],
        "surfaces": [
          "about",
          "services",
          "careers"
        ],
        "earns": "qualifies the cheap gates; the stack they actually run lives here"
      }
    ]
  }
}
