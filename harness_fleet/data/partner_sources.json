{
  "schema": "partner_sources_v1",
  "goal": "Find implementation partners, and prove whether they can deliver revenue-generating work.",
  "placeholders": {
    "tech": [
      "Kafka",
      "Snowflake",
      "Kubernetes",
      "dbt",
      "Postgres"
    ],
    "vertical": [
      "fintech",
      "healthcare",
      "retail",
      "logistics"
    ]
  },
  "stages": {
    "find": {
      "comment": "Cold start: no partner list yet. Every backend the fleet ships, aimed at firms that sell implementation work.",
      "ddgs": [
        "site:clutch.co/it-services \"{tech}\" \"case study\"",
        "site:clutch.co/developers \"{tech}\" clients",
        "\"{tech}\" \"implementation partner\" \"case study\"",
        "\"{tech}\" \"systems integrator\" certified",
        "\"{tech}\" consultancy \"our client\" migration",
        "\"managed service provider\" \"{tech}\" \"{vertical}\""
      ],
      "searxng": [
        "site:g2.com \"{tech}\" \"service provider\"",
        "\"{tech}\" \"professional services\" partner directory"
      ],
      "hn": [
        "who is hiring \"{tech}\" solutions architect",
        "Show HN {tech} consultancy",
        "\"{tech}\" implementation agency experience"
      ],
      "reddit": {
        "subreddits": [
          "dataengineering",
          "devops",
          "snowflake",
          "kafka",
          "consulting"
        ],
        "queries": [
          "recommend a consultancy for {tech}",
          "agency to help with {tech} migration",
          "who did your {tech} implementation"
        ]
      },
      "stackexchange": {
        "sites": [
          "stackoverflow",
          "serverfault",
          "softwareengineering"
        ],
        "tags": [
          "apache-kafka",
          "snowflake",
          "kubernetes",
          "dbt"
        ],
        "comment": "Engineers who answer in public are a credibility signal for the firm they work for."
      },
      "discourse": {
        "instances": [
          "https://discuss.python.org",
          "https://community.dbt.com",
          "https://discourse.snowflake.com"
        ],
        "queries": [
          "partner recommendation {tech}",
          "implementation partner {tech}"
        ]
      },
      "devto": [
        "{tech} migration lessons learned consulting",
        "{tech} implementation case study"
      ],
      "lobsters": [
        "{tech} migration",
        "{tech} production"
      ],
      "lemmy": [
        "{tech} consulting recommendation"
      ],
      "yc": [
        "comment: batch companies in {vertical} (firmographics: team size, sector, batch)"
      ],
      "fetch": {
        "comment": "Vendor partner registries and review directories are curated lists of exactly who we are looking for.",
        "registry_urls": [
          "https://partners.snowflake.com/",
          "https://partners.amazonaws.com/",
          "https://www.confluent.io/partners/",
          "https://cloud.google.com/find-a-partner",
          "https://partner.microsoft.com/en-us/partners"
        ],
        "directory_urls": [
          "https://clutch.co/it-services",
          "https://clutch.co/developers",
          "https://www.g2.com/categories/professional-services"
        ]
      }
    }
  },
  "evidence_rules": {
    "attribution": "A hit counts toward a partner only when the partner's domain or name appears in the URL or the captured text. Unattributed hits are leads, never evidence.",
    "categories": [
      "first_party_case_study",
      "vendor_registry",
      "b2b_directory_audit",
      "community_and_social",
      "ats_requisitions",
      "general_web"
    ],
    "tier_1_gate": "At least 2 distinct categories, at least one of which is not first_party_case_study. general_web never satisfies the gate on its own.",
    "recency_half_lives_days": {
      "hiring_catalyst": 21,
      "growth_signal": 90,
      "community_mention": 180,
      "stack_or_commercial_fact": 365
    },
    "practice_signals": [
      "case study",
      "client",
      "customer",
      "consulting",
      "implementation",
      "integration",
      "migration",
      "managed service",
      "professional services",
      "delivery",
      "practice",
      "partner",
      "systems integrator",
      "hiring",
      "solutions architect",
      "services"
    ]
  }
}
