{
  "schema": "partner_sources_v1",
  "goal": "Find implementation partners, and prove whether they can deliver revenue-generating work.",
  "placeholders": {
    "tech": [
      "Kafka",
      "Snowflake",
      "Kubernetes",
      "dbt",
      "Postgres"
    ],
    "vertical": [
      "fintech",
      "healthcare",
      "retail",
      "logistics"
    ]
  },
  "stages": {
    "find": {
      "comment": "Cold start: no partner list yet. Every backend the fleet ships, aimed at firms that sell implementation work.",
      "ddgs": [
        "site:clutch.co/it-services \"{tech}\" \"case study\"",
        "site:clutch.co/developers \"{tech}\" clients",
        "\"{tech}\" \"implementation partner\" \"case study\"",
        "\"{tech}\" \"systems integrator\" certified",
        "\"{tech}\" consultancy \"our client\" migration",
        "\"managed service provider\" \"{tech}\" \"{vertical}\""
      ],
      "searxng": [
        "site:g2.com \"{tech}\" \"service provider\"",
        "\"{tech}\" \"professional services\" partner directory"
      ],
      "hn": [
        "who is hiring \"{tech}\" solutions architect",
        "Show HN {tech} consultancy",
        "\"{tech}\" implementation agency experience"
      ],
      "reddit": {
        "subreddits": [
          "dataengineering",
          "devops",
          "snowflake",
          "kafka",
          "consulting"
        ],
        "queries": [
          "recommend a consultancy for {tech}",
          "agency to help with {tech} migration",
          "who did your {tech} implementation"
        ]
      },
      "stackexchange": {
        "sites": [
          "stackoverflow",
          "serverfault",
          "softwareengineering"
        ],
        "tags": [
          "apache-kafka",
          "snowflake",
          "kubernetes",
          "dbt"
        ],
        "comment": "Engineers who answer in public are a credibility signal for the firm they work for."
      },
      "discourse": {
        "instances": [
          "https://discuss.python.org",
          "https://community.dbt.com",
          "https://discourse.snowflake.com"
        ],
        "queries": [
          "partner recommendation {tech}",
          "implementation partner {tech}"
        ]
      },
      "devto": [
        "{tech} migration lessons learned consulting",
        "{tech} implementation case study"
      ],
      "lobsters": [
        "{tech} migration",
        "{tech} production"
      ],
      "lemmy": [
        "{tech} consulting recommendation"
      ],
      "yc": [
        "comment: batch companies in {vertical} (firmographics: team size, sector, batch)"
      ],
      "fetch": {
        "comment": "Vendor partner registries and review directories are curated lists of exactly who we are looking for.",
        "registry_urls": [
          "https://partners.snowflake.com/",
          "https://partners.amazonaws.com/",
          "https://www.confluent.io/partners/",
          "https://cloud.google.com/find-a-partner",
          "https://partner.microsoft.com/en-us/partners"
        ],
        "directory_urls": [
          "https://clutch.co/it-services",
          "https://clutch.co/developers",
          "https://www.g2.com/categories/professional-services"
        ]
      }
    },
    "enrich": {
      "comment": "Given one partner domain (from the find stage, or from a list you already have). Produces the evidence the score is built on.",
      "first_party": {
        "sitemap": "{origin}/sitemap.xml",
        "crawl": [
          "/services",
          "/partners",
          "/case-studies",
          "/customers",
          "/about",
          "/careers",
          "/blog"
        ],
        "yields": [
          "service model",
          "target stack",
          "client logos",
          "case study outcomes",
          "delivery coverage"
        ]
      },
      "ats": {
        "comment": "Consultancies hire delivery engineers on public boards: roles, seniority and locations prove live demand and capacity.",
        "probe": [
          "https://boards.greenhouse.io/{slug}",
          "https://jobs.ashbyhq.com/{slug}",
          "https://jobs.lever.co/{slug}"
        ],
        "yields": [
          "hiring signals",
          "delivery locations",
          "stack in requisitions"
        ]
      },
      "third_party": {
        "urls": [
          "https://clutch.co/profile/{slug}",
          "https://www.g2.com/products/{slug}/reviews",
          "https://www.zoominfo.com/c/{slug}"
        ],
        "yields": [
          "minimum project size",
          "hourly rate",
          "employee count",
          "review score",
          "revenue estimate"
        ]
      },
      "vendor_registry": {
        "comment": "A listing in the vendor's own partner directory is co-sell potential and a non-first-party category.",
        "query": "site:partners.{vendor}.com {domain}"
      },
      "mentions": {
        "backends": [
          "hn",
          "reddit",
          "stackexchange",
          "discourse",
          "devto",
          "lobsters",
          "lemmy"
        ],
        "query_template": "\"{domain}\"",
        "yields": [
          "third-party validation",
          "engineering output",
          "named implementations"
        ]
      },
      "web": {
        "queries": [
          "\"{domain}\" case study",
          "\"{domain}\" partnership announcement",
          "\"{domain}\" funding OR acquisition OR \"new office\"",
          "\"{domain}\" award OR \"partner of the year\""
        ],
        "yields": [
          "growth signals",
          "dated events",
          "press"
        ]
      }
    },
    "vendor_stories": {
      "comment": "Independent prose about a partner, published by the vendor it works with: the strongest non-first-party evidence that a practice is real, and the half of the tier-1 evidence gate that review sites used to supply before they started answering 403. Enumerated, not searched: walk each vendor's sitemap index one level, keep the story paths, fetch the pages, and let attribution file each story under the partner it names. Probed 2026-09: snowflake/databricks/elastic sitemap indexes answer 200 and list story sub-sitemaps; datadog and mongodb serve indexes too; confluent answers 404 on both index paths, and the AWS, Google Cloud, Azure marketplace and AppSource directories are client-rendered listings with no server-side prose, so those stay search-only.",
      "vendors": {
        "snowflake": {
          "sitemap": "https://www.snowflake.com/sitemap_index.xml",
          "story_paths": [
            "/customers/",
            "/case-studies/"
          ]
        },
        "databricks": {
          "sitemap": "https://www.databricks.com/en-customer-assets/sitemap/sitemap-index.xml",
          "story_paths": [
            "/customers/",
            "/customer-assets/"
          ]
        },
        "elastic": {
          "sitemap": "https://www.elastic.co/sitemap.xml",
          "story_paths": [
            "/customers"
          ]
        },
        "datadog": {
          "sitemap": "https://www.datadoghq.com/sitemap.xml",
          "story_paths": [
            "/customers",
            "/case-studies"
          ]
        },
        "mongodb": {
          "sitemap": "https://www.mongodb.com/sitemap.xml",
          "story_paths": [
            "/customers",
            "/case-studies"
          ]
        },
        "aws": {
          "hub": "https://aws.amazon.com/partners/success/",
          "story_path_prefix": "/partners/success/",
          "slug_form": "<customer>-<partner>"
        }
      },
      "search_only": [
        "google-cloud",
        "azure-marketplace",
        "appsource",
        "salesforce-appexchange",
        "confluent"
      ],
      "yields": [
        "third-party validation",
        "named implementations",
        "stack delivery",
        "case study outcomes"
      ],
      "strategy": "Hub-and-spoke per vendor: fetch the vendor's story hub (or its sitemap index, one level down), collect the story URLs, fetch each story, and let attribution file it under the partner the story names. Verified 2026-09: aws.amazon.com/partners/success/ answers 200 with server-rendered story links whose slug carries the partner (/partners/success/biolytica-presidio/), and a fetched story carries ~2,400 words naming the customer, the partner and quantified outcomes — non-first-party prose about the work, fetchable without a key. Databricks' customer-assets sitemap lists 918 stories, but the sampled pages credit no partner in server-rendered text, so stories that name nobody simply file under no partner. partners.amazonaws.com partner pages are client-rendered shells (27 words) and the AWS/Google/Azure/AppSource/Salesforce directories stay search-only."
    }
  },
  "evidence_rules": {
    "attribution": "A hit counts toward a partner only when the partner's domain or name appears in the URL or the captured text. Unattributed hits are leads, never evidence.",
    "categories": [
      "first_party_case_study",
      "vendor_registry",
      "b2b_directory_audit",
      "community_and_social",
      "ats_requisitions",
      "general_web"
    ],
    "tier_1_gate": "At least 2 distinct categories, at least one of which is not first_party_case_study. general_web never satisfies the gate on its own.",
    "recency_half_lives_days": {
      "hiring_catalyst": 21,
      "growth_signal": 90,
      "community_mention": 180,
      "stack_or_commercial_fact": 365
    },
    "practice_signals": [
      "case study",
      "client",
      "customer",
      "consulting",
      "implementation",
      "integration",
      "migration",
      "managed service",
      "professional services",
      "delivery",
      "practice",
      "partner",
      "systems integrator",
      "hiring",
      "solutions architect",
      "services"
    ]
  }
}
